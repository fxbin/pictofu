# GA4 product analytics is opt-in. Configure a real GA4 Web Measurement ID before enabling.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Vercel Web Analytics page/visitor tracking is initialized by <Analytics />.
# Custom Events currently require an eligible Vercel plan; keep this false unless available.
NEXT_PUBLIC_VERCEL_CUSTOM_EVENTS_ENABLED=false
