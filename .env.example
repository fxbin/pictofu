# GA4 product analytics is opt-in. Configure a real GA4 Web Measurement ID before enabling.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Vercel Web Analytics page/visitor tracking is initialized globally by app/layout.tsx.
