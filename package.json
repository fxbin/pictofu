{
  "name": "pictofu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify:release-policy": "node scripts/verify-release-boundary.mjs",
    "test:p0": "node scripts/test-p0-contracts.mjs",
    "test:p1": "node scripts/test-p1-product-truth.mjs",
    "test:growth": "node scripts/test-growth-measurement.mjs",
    "test:upload": "node scripts/test-upload-flow.mjs",
    "test:editor": "node scripts/test-editor-v2.mjs",
    "test:guides": "node scripts/test-guides.mjs",
    "verify:p0": "npm run verify:release-policy && npm run test:p0",
    "verify:p1": "npm run verify:p0 && npm run test:p1",
    "verify:growth": "npm run verify:p1 && npm run test:growth && npm run test:upload && npm run test:editor && npm run test:guides"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "next": "16.2.11",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^20.0.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.11",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "24.x"
  }
}
